{
  "name": "agentic-guardrail-ts",
  "version": "3.0.0",
  "type": "module",
  "description": "Tool-enforced guardrails for coding agents in TypeScript projects: agent skills and a Claude Code plugin that install Oxlint, TypeScript 7, dependency-cruiser, Knip, Vitest coverage floors, lefthook, a ratchet baseline and agent hooks.",
  "keywords": [
    "ai",
    "agents",
    "guardrails",
    "typescript",
    "oxlint",
    "dependency-cruiser",
    "knip",
    "lefthook",
    "monorepo",
    "code-quality",
    "claude-code",
    "codex",
    "agent-skills",
    "pre-commit",
    "static-analysis"
  ],
  "license": "MIT",
  "author": "Avinava Maiti",
  "repository": {
    "type": "git",
    "url": "https://github.com/Avinava/agentic-guardrail-ts.git"
  },
  "bugs": {
    "url": "https://github.com/Avinava/agentic-guardrail-ts/issues"
  },
  "homepage": "https://github.com/Avinava/agentic-guardrail-ts#readme",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "render": "node scripts/render.mjs",
    "render:check": "node scripts/render.mjs --check",
    "docs:check": "node scripts/docs-check.mjs",
    "test:fixtures": "node scripts/fixture-test.mjs",
    "test:packs": "node --test scripts/packs-*-test.mjs"
  }
}
